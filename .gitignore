# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/

# production / build output
/build
/dist
/out

# local agent / editor config (keep .claude/skills tracked)
/.claude/settings.local.json
/.claude/launch.json

# stray downloads
*.zip

# misc
.DS_Store
.env*

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# personal Obsidian vault (synced copy of the root explainer)
Beadwork/

# test-run artifacts (screenshots/logs/downloads regenerate on every run)
scripts/*.png
scripts/*.out
scripts/*.err
scripts/exporttest-*

# sibling apps manage their own deps/builds (main app's are rooted above)
node_modules/
dist/

# huge installers / third-party downloads that don't belong in history
assets/icons/*.dmg
clean-code-skills-main/
